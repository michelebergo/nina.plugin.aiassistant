<ResourceDictionary
    x:Class="NINA.Plugin.AIAssistant.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.AIAssistant">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- Options View Template - must use key pattern: <PluginName>_Options.
         Sections follow the order in which a user sets the plugin up: provider, then what the
         assistant may do, then what it knows, then the advanced extras. Secondary text uses the
         theme's disabled brush so it reads in both light and dark themes. -->
    <DataTemplate x:Key="AI Assistant_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="10">

                <!-- ===== AI provider ===== -->
                <TextBlock Text="AI provider" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="Pick a provider, give it the key, choose the model, then press Test. Ollama runs on your own machine and needs no key; Google Gemini and Mistral have free tiers. For equipment control pick Anthropic Claude, Google Gemini or Ollama." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <TextBlock Text="Provider:" Margin="0,0,0,2"/>
                <ComboBox x:Name="ProviderSelector"
                          Loaded="ProviderSelector_Loaded"
                          SelectionChanged="ProviderSelector_Changed"
                          HorizontalAlignment="Left" MinWidth="300">
                    <!-- Retired: shown only to someone who still has it selected, so their
                         saved choice is not rewritten under them; everyone else never sees it. -->
                    <ComboBoxItem Content="GitHub Models (RETIRED)" Tag="GitHub" Visibility="{Binding IsGitHubSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ComboBoxItem Content="Ollama (LOCAL, equipment control)" Tag="Ollama"/>
                    <ComboBoxItem Content="Google Gemini (FREE TIER, equipment control)" Tag="Google"/>
                    <ComboBoxItem Content="Anthropic Claude (PAID, equipment control)" Tag="Anthropic"/>
                    <ComboBoxItem Content="OpenAI (PAID, chat only)" Tag="OpenAI"/>
                    <ComboBoxItem Content="Mistral AI (PAID, chat only)" Tag="Mistral"/>
                </ComboBox>
                <TextBlock x:Name="ProviderStatusText" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>

                <!-- GitHub Models (retired) -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsGitHubSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="GitHub retired this service on 30 July 2026 - it no longer works for anyone. Switch to Ollama (local, free), Google Gemini or Mistral (free tiers)." Foreground="Salmon" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="GitHub Personal Access Token:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <PasswordBox x:Name="GitHubTokenBox" Width="360" Loaded="GitHubToken_Loaded" PasswordChanged="GitHubToken_Changed"/>
                        <Button Content="Test" Click="TestGitHubKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get token" Click="GetGitHubToken_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="GitHubTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Model:" Margin="0,10,0,2"/>
                    <ComboBox x:Name="GitHubModelComboBox" SelectedValue="{Binding GitHubModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="300" Loaded="GitHubModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBlock Text="Or enter a model ID:" Margin="0,8,0,2" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>
                    <TextBox x:Name="GitHubCustomModelBox" Text="{Binding GitHubModelId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Ollama -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsOllamaSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Ollama server URL:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" Width="360" LostFocus="OllamaEndpoint_LostFocus"/>
                        <Button Content="Test" Click="TestOllama_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get Ollama" Click="GetOllama_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="OllamaTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Model (read from the server):" Margin="0,10,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ComboBox x:Name="OllamaModelComboBox" SelectedValue="{Binding OllamaModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True" MinWidth="300" Loaded="OllamaModel_Loaded" DropDownOpened="OllamaModelCombo_DropDownOpened"/>
                        <Button Content="Refresh" Click="RefreshOllamaModels_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock Text="Run 'ollama pull modelname' to download a model; the list shows what the server has. For equipment control and external tools use a tool-capable model (qwen2.5, llama3.1 or newer)." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <CheckBox Content="Disable model thinking (recommended)" IsChecked="{Binding OllamaDisableThinking, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="Thinking-capable models (Gemma 4, Qwen 3.x, DeepSeek) reason at length before answering, which can multiply response times. Turn off only on fast hardware." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Foreground="{DynamicResource ButtonForegroundDisabledBrush}" Margin="0,8,0,0">
                        <Run Text="Model on another PC of your LAN: set the URL above to http://&lt;other-pc-ip&gt;:11434 and start Ollama there with OLLAMA_HOST=0.0.0.0, with port 11434 open in its firewall. Equipment control still runs on this NINA PC; only the model is remote."/>
                    </TextBlock>
                </StackPanel>

                <!-- Google Gemini -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsGoogleSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Google API key:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <PasswordBox x:Name="GoogleTokenBox" Width="360" Loaded="GoogleToken_Loaded" PasswordChanged="GoogleToken_Changed"/>
                        <Button Content="Test" Click="TestGoogleKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get key" Click="GetGoogleKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="GoogleTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Free tier from Google AI Studio; the model list is fetched live with the key." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock Text="Model:" Margin="0,10,0,2"/>
                    <ComboBox x:Name="GoogleModelComboBox" SelectedValue="{Binding GoogleModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="300" Loaded="GoogleModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBlock Text="Or enter a model ID:" Margin="0,8,0,2" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>
                    <TextBox x:Name="GoogleCustomModelBox" Text="{Binding GoogleModelId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="Any model ID, e.g. gemini-flash-latest, gemini-2.5-pro"/>
                </StackPanel>

                <!-- Anthropic -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsAnthropicSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Anthropic API key:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <PasswordBox x:Name="AnthropicTokenBox" Width="360" Loaded="AnthropicToken_Loaded" PasswordChanged="AnthropicToken_Changed"/>
                        <Button Content="Test" Click="TestAnthropicKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get key" Click="GetAnthropicKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="AnthropicTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Requires an Anthropic account with credit; the model list is fetched live with the key." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock Text="Model:" Margin="0,10,0,2"/>
                    <ComboBox x:Name="AnthropicModelComboBox" SelectedValue="{Binding AnthropicModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="300" Loaded="AnthropicModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBlock Text="Or enter a model ID:" Margin="0,8,0,2" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>
                    <TextBox x:Name="AnthropicCustomModelBox" Text="{Binding AnthropicModelId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="Any model ID, e.g. claude-sonnet-4-5-20250929"/>
                </StackPanel>

                <!-- OpenAI -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsOpenAISelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chat only: OpenAI cannot read or control your NINA equipment from this plugin yet (no tool calling). For equipment control choose Anthropic Claude, Google Gemini or Ollama." Foreground="Salmon" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="OpenAI API key:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <PasswordBox x:Name="OpenAITokenBox" Width="360" Loaded="OpenAIToken_Loaded" PasswordChanged="OpenAIToken_Changed"/>
                        <Button Content="Test" Click="TestOpenAIKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get key" Click="GetOpenAIKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="OpenAITestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Requires an OpenAI account with credit; the model list is fetched live with the key." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock Text="Model:" Margin="0,10,0,2"/>
                    <ComboBox x:Name="OpenAIModelComboBox" SelectedValue="{Binding OpenAIModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="300" Loaded="OpenAIModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBlock Text="Or enter a model ID:" Margin="0,8,0,2" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>
                    <TextBox x:Name="OpenAICustomModelBox" Text="{Binding OpenAIModelId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="Any model ID, e.g. gpt-4o, gpt-4.1-mini"/>
                </StackPanel>

                <!-- Mistral AI -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMistralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chat only: Mistral cannot read or control your NINA equipment from this plugin yet (no tool calling). For equipment control choose Anthropic Claude, Google Gemini or Ollama." Foreground="Salmon" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="Mistral API key:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <PasswordBox x:Name="MistralTokenBox" Width="360" Loaded="MistralToken_Loaded" PasswordChanged="MistralToken_Changed"/>
                        <Button Content="Test" Click="TestMistralKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                        <Button Content="Get key" Click="GetMistralKey_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="MistralTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Free tier and paid plans; the model list is fetched live with the key." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock Text="Model:" Margin="0,10,0,2"/>
                    <ComboBox x:Name="MistralModelComboBox" SelectedValue="{Binding MistralModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="300" Loaded="MistralModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                    <TextBlock Text="Or enter a model ID:" Margin="0,8,0,2" Foreground="{DynamicResource ButtonForegroundDisabledBrush}"/>
                    <TextBox x:Name="MistralCustomModelBox" Text="{Binding MistralModelId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" ToolTip="Any model ID, e.g. mistral-large-latest, codestral-latest"/>
                </StackPanel>


                <!-- ===== Equipment control ===== -->
                <TextBlock Text="Equipment control" FontWeight="Bold" FontSize="14" Margin="0,24,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="Lets the assistant read and operate your equipment - status, connect, capture, slew, focus, filters, guiding - through the NINA Advanced API plugin, which must be installed and running." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <!-- Shown instead of the switch when the provider has no tool loop: hiding the
                     whole section left the user wondering where it went. -->
                <StackPanel Visibility="{Binding IsChatOnlyProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Not available with this provider: OpenAI and Mistral have no tool calling in this plugin yet, so the assistant can only answer questions. Choose Anthropic Claude, Google Gemini or Ollama above - or, for an agent that works your equipment with any provider and model, see the OpenCode for N.I.N.A. plugin." Foreground="Salmon" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="OpenCode for N.I.N.A." Click="GetOpenCodePlugin_Click" Padding="10,2" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsMCPProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="Enable equipment control (MCP)" IsChecked="{Binding MCPEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Advanced API host and port:" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox Text="{Binding MCPNinaHost, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <TextBox Text="{Binding MCPNinaPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,0,0"/>
                        <Button Content="Test connection" Click="TestMCPConnection_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                    <TextBlock x:Name="MCPTestResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="With it on you can ask: 'Connect all equipment', 'Take a 30s exposure of M31', 'Cool the camera to -10°C', 'Start guiding'. Ollama needs a tool-capable model." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="Get Advanced API plugin" Click="GetAdvancedAPIPlugin_Click" Padding="10,2"/>
                        <Button Content="nina_mcp_server on GitHub" Click="GetMCPRepo_Click" Margin="8,0,0,0" Padding="10,2"/>
                    </StackPanel>
                </StackPanel>


                <!-- ===== Your rig ===== -->
                <TextBlock Text="Your rig" FontWeight="Bold" FontSize="14" Margin="0,24,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="A few lines from your active NINA profile travel with each message: site coordinates and elevation, telescope focal length and ratio, camera pixel size and the resulting arcsec/pixel, and where images and sequence templates are written. Without them the assistant answers questions about your own equipment from general knowledge - which is to say, it guesses. The exact text is written to the NINA log every time it changes, so you can always read what was sent." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <CheckBox Content="Send a summary of my NINA profile to the assistant" IsChecked="{Binding SendProfileSummary, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBlock Text="Turn this off if you would rather not send your observing coordinates and folder paths to a cloud provider. Ollama runs on your own machine, so nothing leaves it either way." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>


                <!-- ===== External MCP servers (advanced) ===== -->
                <TextBlock Text="External MCP servers (advanced)" FontWeight="Bold" FontSize="14" Margin="0,24,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="Give the assistant more tools - web search, Wikipedia, your files - by connecting MCP servers in the standard mcpServers JSON used by Claude Desktop and VS Code. Each server can be python, node, npx, docker or any executable. Works with Anthropic Claude, Google Gemini and Ollama." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <TextBox x:Name="ExternalMCPServersBox"
                         Text="{Binding ExternalMCPServersJson, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" MinHeight="140" Width="520" HorizontalAlignment="Left"
                         ToolTip="Standard mcpServers JSON. Add several servers under the mcpServers object; tool names that collide across servers are prefixed with the server name."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <Button Content="Validate" Click="ValidateExternalMCP_Click" Padding="10,2"/>
                    <Button Content="Reset to default" Click="ResetExternalMCP_Click" Margin="8,0,0,0" Padding="10,2"/>
                </StackPanel>
                <TextBlock x:Name="ExternalMCPValidateResult" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <TextBlock Text="Add a ready-made server:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="UsefulServersCombo" MinWidth="220" SelectedIndex="0">
                        <ComboBoxItem Content="Fetch (web pages)" Tag="fetch"/>
                        <ComboBoxItem Content="DuckDuckGo Search (free)" Tag="ddg-search"/>
                        <ComboBoxItem Content="Brave Search (API key)" Tag="brave-search"/>
                        <ComboBoxItem Content="Context7 docs (API key)" Tag="context7"/>
                        <ComboBoxItem Content="Memory" Tag="memory"/>
                        <ComboBoxItem Content="Sequential Thinking" Tag="sequential-thinking"/>
                        <ComboBoxItem Content="Wikipedia" Tag="wikipedia"/>
                        <ComboBoxItem Content="arXiv papers" Tag="arxiv"/>
                        <ComboBoxItem Content="Time" Tag="time"/>
                        <ComboBoxItem Content="Filesystem (NINA logs)" Tag="filesystem"/>
                        <ComboBoxItem Content="Everything (test server)" Tag="everything"/>
                    </ComboBox>
                    <Button Content="Add" Click="AddUsefulServer_Click" Margin="8,0,0,0" Padding="10,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Content="Documentation" Click="GetExternalMCPDocs_Click" Padding="10,2"/>
                    <Button Content="Example server" Click="GetExternalMCPExample_Click" Margin="8,0,0,0" Padding="10,2"/>
                </StackPanel>


                <!-- ===== Autopilot (advanced) ===== -->
                <TextBlock Text="Autopilot connection (advanced)" FontWeight="Bold" FontSize="14" Margin="0,24,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="If you run the separate nina.autopilot orchestrator, a status panel at the top of the chat shows its phase, target, LLM budget, recent events and an E-STOP button. The E-STOP stops the sequence, closes the dome, parks the mount, warms the camera and ends the session." Foreground="{DynamicResource ButtonForegroundDisabledBrush}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <CheckBox Content="Show the orchestrator status panel" IsChecked="{Binding OrchestratorEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Text="Dashboard URL:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding OrchestratorUrl, UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left" ToolTip="http://127.0.0.1:8765 on the same PC, or http://&lt;tailscale-ip&gt;:8765 over Tailscale"/>
                <TextBlock Text="Poll interval (seconds):" Margin="0,8,0,2"/>
                <TextBox Text="{Binding OrchestratorPollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" ToolTip="How often the panel refreshes from /api/status and /api/events. 5 s is a good default."/>


                <!-- ===== About ===== -->
                <TextBlock Text="About AI Assistant" FontWeight="Bold" FontSize="14" Margin="0,24,0,2"/>
                <Separator HorizontalAlignment="Left" Width="520" Margin="0,0,0,8"/>
                <TextBlock Text="A chat panel in NINA's imaging tab that answers astrophotography questions and, with a capable provider, reads and operates your equipment. It consults a local knowledge wiki about your own rig before answering, shows what it is doing while it works, and tells you what the conversation has cost." TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Text="This plugin is developed and maintained independently by michelebergo. If you find it useful, you can support its continued development." TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                <Button Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left" Command="{Binding OpenSupportPageCommand}" Content="☕ Support development"/>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
