<ResourceDictionary
    x:Class="NINA.Plugin.AIAssistant.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.AIAssistant">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <DataTemplate x:Key="AI Assistant_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="10">
                
                <TextBlock Text="AI Assistant Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,15" FontSize="12" Opacity="0.7">
                    <Run Text="Intelligent AI-powered assistant for NINA with advanced capabilities:"/><LineBreak/>
                    <Run Text="• Multiple AI Providers: Ollama (local, free), Google Gemini, Mistral, OpenAI, Anthropic Claude"/><LineBreak/>
                    <Run Text="• MCP Equipment Control: Natural language control of cameras, mounts, focusers, filter wheels, guiding, platesolving"/><LineBreak/>
                    <Run Text="• Image Analysis: Intelligent feedback on captures, HFR, star detection, and quality assessment"/><LineBreak/>
                    <Run Text="• Dynamic Model Discovery: Automatically fetches latest available AI models from providers"/><LineBreak/>
                    <Run Text="• Custom Model Support: Enter any model ID manually when new models are released or providers update"/><LineBreak/>
                    <Run Text="• Extensible Architecture: Built-in + external MCP servers for custom tool integration"/>
                </TextBlock>

                <GroupBox Header="Active Provider" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <ComboBox x:Name="ProviderSelector" 
                                  Loaded="ProviderSelector_Loaded"
                                  SelectionChanged="ProviderSelector_Changed" 
                                  HorizontalAlignment="Left" MinWidth="250">
                            <ComboBoxItem Content="GitHub Models (RETIRED)" Tag="GitHub"/>
                            <ComboBoxItem Content="OpenAI (PAID)" Tag="OpenAI"/>
                            <ComboBoxItem Content="Anthropic Claude (MCP)" Tag="Anthropic"/>
                            <ComboBoxItem Content="Google Gemini (FREE)" Tag="Google"/>
                            <ComboBoxItem Content="Ollama (LOCAL)" Tag="Ollama"/>
                            <ComboBoxItem Content="Mistral AI (PAID)" Tag="Mistral"/>
                        </ComboBox>
                        <TextBlock x:Name="ProviderStatusText" Margin="0,5,0,0" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </GroupBox>

                <!-- GitHub Models -->
                <GroupBox Header="GitHub Models (RETIRED)" Margin="0,0,0,10" Visibility="{Binding IsGitHubSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="GitHub retired this service on July 30, 2026 — it no longer works for anyone. Switch to Ollama (local, free), Google Gemini or Mistral (free tiers)." FontSize="11" Foreground="Salmon" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="GitHub Personal Access Token:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GitHubTokenBox" Width="350" HorizontalAlignment="Left" Margin="0" Loaded="GitHubToken_Loaded" PasswordChanged="GitHubToken_Changed"/>
                            <Button Grid.Column="1" Content="Test" Click="TestGitHubKey_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Token" Click="GetGitHubToken_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="GitHubTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="GitHubModelComboBox" SelectedValue="{Binding GitHubModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="200" Loaded="GitHubModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                        <TextBlock Text="Or enter custom model ID:" Margin="0,10,0,5" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="GitHubCustomModelBox" Text="{Binding GitHubModelId, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" ToolTip="Enter any model ID (e.g., gpt-4o-mini, Llama-3.3-70B-Instruct)"/>
                    </StackPanel>
                </GroupBox>

                <!-- OpenAI -->
                <GroupBox Header="OpenAI (PAID)" Margin="0,0,0,10" Visibility="{Binding IsOpenAISelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="GPT-4, GPT-4o, o1 models - Requires OpenAI account with credits" FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <TextBlock Text="OpenAI API Key:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="OpenAITokenBox" Width="350" HorizontalAlignment="Left" Margin="0" Loaded="OpenAIToken_Loaded" PasswordChanged="OpenAIToken_Changed"/>
                            <Button Grid.Column="1" Content="Test" Click="TestOpenAIKey_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Key" Click="GetOpenAIKey_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="OpenAITestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="OpenAIModelComboBox" SelectedValue="{Binding OpenAIModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="200" Loaded="OpenAIModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                        <TextBlock Text="Or enter custom model ID:" Margin="0,10,0,5" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="OpenAICustomModelBox" Text="{Binding OpenAIModelId, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" ToolTip="Enter any model ID (e.g., gpt-4o, gpt-4-turbo, o1-preview)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Anthropic -->
                <GroupBox Header="Anthropic Claude (PAID)" Margin="0,0,0,10" Visibility="{Binding IsAnthropicSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Claude 3.5 Sonnet, Opus, Haiku - Requires Anthropic account" FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <TextBlock Text="Anthropic API Key:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AnthropicTokenBox" Width="350" HorizontalAlignment="Left" Margin="0" Loaded="AnthropicToken_Loaded" PasswordChanged="AnthropicToken_Changed"/>
                            <Button Grid.Column="1" Content="Test" Click="TestAnthropicKey_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Key" Click="GetAnthropicKey_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="AnthropicTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="AnthropicModelComboBox" SelectedValue="{Binding AnthropicModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="250" Loaded="AnthropicModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                        <TextBlock Text="Or enter custom model ID:" Margin="0,10,0,5" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="AnthropicCustomModelBox" Text="{Binding AnthropicModelId, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" ToolTip="Enter any model ID (e.g., claude-sonnet-4-20250514, claude-3-7-sonnet-20250219)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Google Gemini -->
                <GroupBox Header="Google Gemini (FREE TIER)" Margin="0,0,0,10" Visibility="{Binding IsGoogleSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Gemini 1.5 Flash/Pro - Free tier available with Google AI Studio" FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <TextBlock Text="Google API Key:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GoogleTokenBox" Width="350" HorizontalAlignment="Left" Margin="0" Loaded="GoogleToken_Loaded" PasswordChanged="GoogleToken_Changed"/>
                            <Button Grid.Column="1" Content="Test" Click="TestGoogleKey_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Key" Click="GetGoogleKey_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="GoogleTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="GoogleModelComboBox" SelectedValue="{Binding GoogleModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="200" Loaded="GoogleModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                        <TextBlock Text="Or enter custom model ID:" Margin="0,10,0,5" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="GoogleCustomModelBox" Text="{Binding GoogleModelId, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" ToolTip="Enter any model ID (e.g., gemini-2.0-flash-001, gemini-2.5-pro, gemini-1.5-pro)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ollama -->
                <GroupBox Header="Ollama (LOCAL/FREE)" Margin="0,0,0,10" Visibility="{Binding IsOllamaSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Run AI models locally - Completely free, no API key needed" FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <TextBlock Text="Ollama Server URL:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left" Margin="0" LostFocus="OllamaEndpoint_LostFocus"/>
                            <Button Grid.Column="1" Content="Test" Click="TestOllama_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Ollama" Click="GetOllama_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="OllamaTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model (auto-detected from the server):" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="OllamaModelComboBox" SelectedValue="{Binding OllamaModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True" HorizontalAlignment="Left" MinWidth="200" Loaded="OllamaModel_Loaded" DropDownOpened="OllamaModelCombo_DropDownOpened"/>
                            <Button Content="Refresh" Click="RefreshOllamaModels_Click" Margin="6,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <TextBlock Text="Tip: Run 'ollama pull modelname' to download models. The list auto-detects installed models from the server (open the dropdown or click Refresh to update)." FontSize="10" Opacity="0.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <CheckBox Content="Disable model thinking (recommended)" IsChecked="{Binding OllamaDisableThinking, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock Text="Thinking-capable models (Gemma 4, Qwen 3.x, DeepSeek) reason at length before answering, which can multiply response times. Turn off only on fast hardware." FontSize="10" Opacity="0.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" Margin="0,8,0,0">
                            <Run Text="Remote model on your LAN: set the Server URL above to http://&lt;other-pc-ip&gt;:11434 (e.g. http://192.168.1.50:11434)."/><LineBreak/>
                            <Run Text="On that machine, start Ollama with OLLAMA_HOST=0.0.0.0 so it accepts network connections, and allow port 11434 through its firewall."/><LineBreak/>
                            <Run Text="Equipment control and external MCP servers still run on this NINA PC; only the model inference is remote. Use a tool-capable model (e.g. qwen2.5, llama3.1) for MCP/web tools."/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Mistral AI -->
                <GroupBox Header="Mistral AI (PAID)" Margin="0,0,0,10" Visibility="{Binding IsMistralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock Text="Mistral Large, Medium, Small, Mixtral - Requires Mistral AI account" FontSize="11" Opacity="0.6" Margin="0,0,0,8"/>
                        <TextBlock Text="Mistral API Key:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="MistralTokenBox" Width="350" HorizontalAlignment="Left" Margin="0" Loaded="MistralToken_Loaded" PasswordChanged="MistralToken_Changed"/>
                            <Button Grid.Column="1" Content="Test" Click="TestMistralKey_Click" Margin="3,0,0,0" MinWidth="50" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="Get Key" Click="GetMistralKey_Click" Margin="3,0,0,0" MinWidth="70" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="MistralTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Model:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="MistralModelComboBox" SelectedValue="{Binding MistralModelId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" HorizontalAlignment="Left" MinWidth="200" Loaded="MistralModel_Loaded" SelectionChanged="ModelCombo_SelectionChanged"/>
                        <TextBlock Text="Or enter custom model ID:" Margin="0,10,0,5" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="MistralCustomModelBox" Text="{Binding MistralModelId, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" ToolTip="Enter any model ID (e.g., mistral-large-latest, open-mixtral-8x7b, codestral-latest)"/>
                    </StackPanel>
                </GroupBox>

                <!-- MCP Section (visible for Anthropic, Google, and Ollama) -->
                <GroupBox Header="🤖 MCP - NINA Equipment Control" Margin="0,0,0,10" Visibility="{Binding IsMCPProviderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="0,0,0,8">When using Anthropic Claude, Google Gemini, or Ollama (with tool-capable models), enable MCP (Model Context Protocol) to give AI direct control over your NINA equipment via the Advanced API plugin.</TextBlock>
                        
                        <CheckBox Content="Enable MCP for Equipment Control" IsChecked="{Binding MCPEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="NINA Advanced API Settings:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Requires: NINA Advanced API plugin installed and enabled" FontSize="10" Opacity="0.5" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Host:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding MCPNinaHost, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="150"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding MCPNinaPort, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="80"/>
                            <Button Grid.Column="2" Content="Test Connection" Click="TestMCPConnection_Click" Margin="10,0,0,0" MinWidth="100" HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <TextBlock x:Name="MCPTestResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
                        
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" Margin="0,10,0,0">With MCP enabled, you can ask the AI to: "Connect all equipment", "Take a 30s exposure of M31", "Cool camera to -10°C", "Start guiding", and more!</TextBlock>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button Content="Get Advanced API Plugin" Click="GetAdvancedAPIPlugin_Click" MinWidth="140"/>
                            <Button Content="MCP GitHub Repo" Click="GetMCPRepo_Click" Margin="10,0,0,0" MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- External MCP Server Configuration -->
                <GroupBox Header="🔧 External MCP Servers (Advanced)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="0,0,0,8">
                            Connect one or more external MCP servers to extend AI capabilities beyond NINA equipment control.
                            Use the standard mcpServers JSON format (the same used by Claude Desktop and VS Code). Each server can be
                            python, node, npx, docker, or any executable. Works with Google Gemini and Ollama providers.
                        </TextBlock>

                        <TextBlock Text="MCP Servers (JSON):" Margin="0,0,0,5"/>
                        <TextBox x:Name="ExternalMCPServersBox"
                                 Text="{Binding ExternalMCPServersJson, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" MinHeight="140" MinWidth="450" HorizontalAlignment="Left"
                                 ToolTip="Standard mcpServers JSON. Add multiple servers under the mcpServers object."/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                            <Button Content="Validate" Click="ValidateExternalMCP_Click" MinWidth="80"/>
                            <Button Content="Reset to NINA Default" Click="ResetExternalMCP_Click" Margin="10,0,0,0" MinWidth="140"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="Useful servers:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="UsefulServersCombo" MinWidth="190" SelectedIndex="0">
                                <ComboBoxItem Content="Fetch (web pages)" Tag="fetch"/>
                                <ComboBoxItem Content="DuckDuckGo Search (free)" Tag="ddg-search"/>
                                <ComboBoxItem Content="Brave Search (API key)" Tag="brave-search"/>
                                <ComboBoxItem Content="Context7 docs (API key)" Tag="context7"/>
                                <ComboBoxItem Content="Memory" Tag="memory"/>
                                <ComboBoxItem Content="Sequential Thinking" Tag="sequential-thinking"/>
                                <ComboBoxItem Content="Wikipedia" Tag="wikipedia"/>
                                <ComboBoxItem Content="arXiv papers" Tag="arxiv"/>
                                <ComboBoxItem Content="Time" Tag="time"/>
                                <ComboBoxItem Content="Filesystem (NINA logs)" Tag="filesystem"/>
                                <ComboBoxItem Content="Everything (test server)" Tag="everything"/>
                            </ComboBox>
                            <Button Content="Add to Config" Click="AddUsefulServer_Click" Margin="6,0,0,0" MinWidth="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <TextBlock x:Name="ExternalMCPValidateResult" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" Margin="0,10,0,0">
                            <Run Text="Example (two servers):"/><LineBreak/>
                            <Run Text="{}{ &quot;mcpServers&quot;: {"/><LineBreak/>
                            <Run Text="    &quot;nina-api&quot;: { &quot;command&quot;: &quot;python&quot;, &quot;args&quot;: [&quot;nina_advanced_api_mcp_server.py&quot;] },"/><LineBreak/>
                            <Run Text="    &quot;weather&quot;: { &quot;command&quot;: &quot;npx&quot;, &quot;args&quot;: [&quot;-y&quot;, &quot;weather-mcp&quot;], &quot;env&quot;: { &quot;API_KEY&quot;: &quot;...&quot; } }"/><LineBreak/>
                            <Run Text="} }"/><LineBreak/>
                            <Run Text="Tool name collisions across servers are auto-prefixed with the server name."/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button Content="Documentation" Click="GetExternalMCPDocs_Click" MinWidth="120"/>
                            <Button Content="Example Server" Click="GetExternalMCPExample_Click" Margin="10,0,0,0" MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Phase 5 — nina.autopilot orchestrator connection -->
                <GroupBox Header="🛰 Autopilot Connection (nina.autopilot)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,8">
                            <Run Text="Connect this plugin to a running nina.autopilot orchestrator. When enabled, a status panel appears at the top of the AI Assistant chat showing current phase, target, LLM budget, recent events, and an E-STOP button."/><LineBreak/>
                            <Run Text="The orchestrator runs separately (see github.com/michelebergo/nina.autopilot). Default URL points at the orchestrator's web dashboard on the same machine."/>
                        </TextBlock>
                        <CheckBox Content="Enable orchestrator status panel"
                                  IsChecked="{Binding OrchestratorEnabled, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="Dashboard URL:" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OrchestratorUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Width="350" HorizontalAlignment="Left"
                                 ToolTip="The orchestrator dashboard URL (typically http://127.0.0.1:8765 on the same PC, or http://&lt;tailscale-ip&gt;:8765 over Tailscale)"/>
                        <TextBlock Text="Poll interval (seconds):" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding OrchestratorPollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Left"
                                 ToolTip="How often the panel refreshes from /api/status and /api/events. 5s is a good default; lower polls more aggressively."/>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" Margin="0,8,0,0">
                            <Run Text="The panel POSTs to /api/estop when the E-STOP button is clicked. This will stop the running sequence, close the dome, park the mount, warm the camera, and end the session."/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11" Opacity="0.6">Tip: For beginners, start with GitHub Models (free) or Ollama (local). For best quality with equipment control, use Anthropic Claude with MCP enabled.</TextBlock>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock
                        Text="This plugin is developed and maintained independently by michelebergo."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="If you find it useful, you can support its continued development."
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,12,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenSupportPageCommand}"
                        Content="☕ Support development" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
