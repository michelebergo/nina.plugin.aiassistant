<ResourceDictionary
    x:Class="NINA.Plugin.AIAssistant.AIChatTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.AIAssistant"
    xmlns:orchestrator="clr-namespace:NINA.Plugin.AIAssistant.Orchestrator"
    xmlns:ninastyle="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- AI Chat Dockable Panel -->
    <DataTemplate DataType="{x:Type local:AIChatVM}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SecondaryBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="10,8" 
                    CornerRadius="5"
                    Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AI Assistant" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,10,0"/>
                            <!-- Model info -->
                            <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                    CornerRadius="3" 
                                    Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentModel}" 
                                           FontSize="10" 
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <!-- MCP Tag -->
                            <Border Background="Goldenrod"
                                    CornerRadius="3"
                                    Padding="4,1" Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMcpSupportedModel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="MCP" 
                                           FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,2,0,0"/>

                        <!-- Usage strip. On its own line, and wrapping, because the panel is
                             docked and narrow: crammed next to the model name these figures
                             collided with each other and with the quota, which is exactly
                             the state they were unreadable in. Each group is labelled, since
                             three sets of token counts side by side are meaningless without
                             saying which is which. -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <!-- Context window: the bar carries the proportion, the text the
                                 absolute numbers, including how much room is left. Hidden
                                 entirely for models whose window we do not know, rather than
                                 drawing a reassuring bar from a guess. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,2"
                                        Visibility="{Binding HasContextUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding TokenUsage}">
                                <TextBlock Text="Context" FontSize="10" Opacity="0.6" Margin="0,0,5,0"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Width="52" Height="6" CornerRadius="3" Margin="0,0,5,0"
                                        Background="{StaticResource TertiaryBackgroundBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasContextWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{Binding ContextPercent, Mode=OneWay}"
                                                 Height="6"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{Binding ContextBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding ContextUsage}"
                                           FontSize="10"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Session totals and estimated cost -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,2"
                                        Visibility="{Binding HasSessionUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="Tokens sent and received in this conversation. The cost is an estimate from published list prices.">
                                <TextBlock Text="Session" FontSize="10" Opacity="0.6" Margin="0,0,5,0"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SessionUsage}"
                                           FontSize="10"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Provider rate-limit budget -->
                            <TextBlock Text="{Binding QuotaUsage}"
                                       FontSize="10"
                                       Opacity="0.8"
                                       Foreground="Goldenrod"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,2"
                                       ToolTip="How much of the provider's rate limit is left"
                                       Visibility="{Binding HasQuotaUsage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            Content="⏹ Stop" 
                            Command="{Binding StopResponseCommand}"
                            Padding="10,5"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" 
                            Content="Clear" 
                            Command="{Binding ClearChatCommand}"
                            Padding="10,5"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Phase 5 — Orchestrator status panel (visible only when enabled) -->
            <Border Grid.Row="1"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Margin="0,0,0,5"
                    Visibility="{Binding OrchestratorEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel DataContext="{Binding OrchestratorVM}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛰 Autopilot:"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                        CornerRadius="3" Padding="6,2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Phase}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding TargetSummary}"
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Opacity="0.85"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BudgetText}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Opacity="0.75"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasBudget, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding ConnectionError}"
                                       FontSize="10"
                                       Foreground="{StaticResource NotificationErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Refresh status now"
                                    MinWidth="30" Padding="5,3"
                                    Margin="0,0,5,0"/>
                            <Button Content="🛑 E-STOP"
                                    Command="{Binding EstopCommand}"
                                    Background="#da3633" Foreground="White"
                                    FontWeight="Bold"
                                    Padding="10,4"/>
                        </StackPanel>
                    </Grid>
                    <Expander Header="Recent events" Margin="0,6,0,0" FontSize="10"
                              Foreground="{StaticResource PrimaryBrush}">
                        <ItemsControl ItemsSource="{Binding Events}"
                                      MaxHeight="120" Margin="0,3,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type orchestrator:OrchestratorEventRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   FontSize="10" Opacity="0.55"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                   FontSize="10"
                                                   Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Chat Messages -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="{StaticResource BackgroundBrush}">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" ScrollChanged="ChatScrollViewer_ScrollChanged">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatMessage}">
                                <Border Margin="5,3" Padding="10,8" CornerRadius="8"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource NotificationErrorBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource NotificationErrorBrush}"/>
                                                </DataTrigger>
                                                <!-- The activity trace is deliberately quieter than the
                                                     conversation: same column as the assistant, but
                                                     transparent and unframed, so the eye reads the
                                                     answers first and the work only when looked for. -->
                                                <DataTrigger Binding="{Binding IsActivity}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="8,2"/>
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid MaxWidth="500">
                                        <!-- Conversation entry -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActivity}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                                     TextWrapping="Wrap"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Padding="0"
                                                     Margin="0"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="10"
                                                       Opacity="0.5"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Activity trace: headline always visible, detail on demand -->
                                        <StackPanel Visibility="{Binding IsActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          HorizontalAlignment="Left"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="0"
                                                          Cursor="Hand"
                                                          ToolTip="Show what the assistant did to answer this">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="11"
                                                               FontStyle="Italic"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" ▾" FontSize="10" Opacity="0.6"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <!-- Even opened, the trace is bounded: a long tool
                                                 sequence scrolls inside its own box instead of
                                                 pushing the conversation off the screen. -->
                                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                                     Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     MaxHeight="160"
                                                     VerticalScrollBarVisibility="Auto"
                                                     TextWrapping="Wrap"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Padding="0"
                                                     Margin="6,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Thinking / working indicator. It shares the chat's row on purpose, floating
                 over the conversation, so it must be anchored to the bottom: stretched (the
                 WPF default) its background painted over the entire message area and the
                 chat looked empty for the whole length of a request. -->
            <Border Grid.Row="2" Margin="6,0,6,6" Padding="10,6" CornerRadius="5"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤔" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text=" ●●●" FontSize="12" VerticalAlignment="Center" Foreground="Goldenrod">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1.0" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="(tool calls can take a while — click Stop to cancel)"
                               FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Input Area -->
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" 
                         Text="{Binding UserMessage, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Center"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="120"
                         Padding="10,8"
                         Margin="0,0,5,0"
                         Background="{StaticResource SecondaryBackgroundBrush}"
                         Foreground="{StaticResource PrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" 
                        Content="Send" 
                        Command="{Binding SendMessageCommand}"
                        Padding="15,8"
                        MinWidth="60"/>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
